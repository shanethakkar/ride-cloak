# RideCloak configuration. Copy to .env and fill in. .env is gitignored.
# All values shown are the in-code defaults; uncomment to override.

# Deterministic seed for the synthetic PII layer and dev-slice sampling.
# RIDECLOAK_SYNTH_SEED=4242

# Validation gate threshold (Phase 1); export refused below this health score.
# RIDECLOAK_GATE_THRESHOLD=90

# Anthropic API key — required only for Phase 6 (AI triage agent). Never commit.
# RIDECLOAK_ANTHROPIC_API_KEY=sk-ant-...
